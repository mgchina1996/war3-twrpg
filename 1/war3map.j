function OO0ui takes integer o69qi returns string
return(Oiu9i((Ac[GetPlayerId((((P[(o69qi)]))))]),(Gl[o69qi])))
endfunction
function OO0pi takes integer o69qi,string s returns nothing
set Gl[o69qi]=s
call SetPlayerName((P[(o69qi)]),s)
call Oiiqi((P[(o69qi)]),Gl[o69qi])
call Oi6Ii((P[(o69qi)]))
if gl[o69qi]!=0 then
call MultiboardSetItemValue((LoadMultiboardItemHandle(Nv,(((Ve))),((o9i0i(gl[o69qi],ki))))),(OO0ui(o69qi)))
endif
call OOoqi(Hl[((Hl[o69qi]))])
endfunction
function OO06i takes integer o69qi returns nothing
if GetLocalPlayer()==(P[(o69qi)])then
call ClearTextMessages()
endif
endfunction
function OO0qi takes integer o69qi,string s,real OIiii returns nothing
call DisplayTimedTextToPlayer((P[(o69qi)]),0,0,OIiii,s)
endfunction
function OO09i takes integer o69qi,string s returns nothing
call OO0qi(o69qi,"|cffffffb3通知:|r "+s,5)
call O16ii("Sound\\Interface\\Hint.wav",2.006,'d',(P[(o69qi)]))
endfunction
function OO_ii takes integer o69qi,string s returns nothing
call OO0qi(o69qi,"|cffff0000错误:|r "+s,5)
call O16ii("Sound\\Interface\\Error.wav",.614,'d',(P[(o69qi)]))
