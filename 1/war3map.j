"
set i86oi=i86oi+("我感到害怕仓惶逃走，而那个战士奔向传来巨响的地方.")+"
"
call SaveStr(Nv,(((i86Ii))),(i86Oi),(i86oi))
call i_661('I069',"万圣节盛会","普瑞斯的公民")
